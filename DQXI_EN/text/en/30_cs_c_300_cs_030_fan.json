 "id": {
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|510": "At last we meet",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|534": "Children of the light",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|558": "I am yet another form of Yggdrasil...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|5b4": "Once called the Holy Dragon",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|5f8": "Long, long ago",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|614": "In the battle with the evil god Calasmos",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|650": "I was defeated",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|674": "And lost my life",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|6a0": "My life is the source of light...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|6e8": "The masterless lights were buried beyond time",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|750": "And the world was swallowed by darkness",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|78c": "But",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|798": "The Watchers who fought beside me...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|7f0": "Their wish worked a miracle",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|838": "And my lost time",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|870": "Began to move once more",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|89c": "I cast off my form",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|8e4": "Became Yggdrasil",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|914": "And created this world",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|944": "Hoping that someday brave ones",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|97c": "Who would destroy Calasmos",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|9ac": "Would come together...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|9e8": "And you have done it",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|a10": "What neither I nor the previous Luminary",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|a68": "Erdwin could achieve: defeating Calasmos...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|ab4": "You are",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|ac4": "The true hero who saved Erdrea...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|b08": "From now on, you",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|b20": "Will be told of as the Hero of Roto",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|b60": "And be a bridge of hope for all",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|bac": "Hero of Roto, {var:1}",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|bd4": "Where there is light, there is also darkness",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|c18": "At the end of long ages, from darkness again",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|c64": "Someone will appear",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|c9c": "Perhaps even I",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|ccc": "May be stained by darkness",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|d08": "But...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|d18": "Human love and courage will never",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|d64": "fade away",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|d8c": "If I should fall into darkness",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|dd0": "Then, please",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|df0": "Take this sword...",
  "/param/scenario/cs/c_300_cs_030.pack|cs_text.bxon|e18": "And seek the time that has passed"
 },
 "tm": {}
}